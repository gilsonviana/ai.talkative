# Server port (default: 3000)
PORT=3000

# LM Studio configuration
# Base URL for LM Studio API (default: http://127.0.0.1:1234/v1)
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Model name to use (default: qwen3.5-9b)
LM_STUDIO_MODEL=qwen3.5-9b

# Temperature for model responses (0-1, lower = more deterministic; default: 0.01)
LM_STUDIO_TEMPERATURE=0.01

# Maximum tokens per response (default: 500)
LM_STUDIO_MAX_TOKENS=500

# Database path (default: ./data/conversations.db)
DB_PATH=./data/conversations.db
